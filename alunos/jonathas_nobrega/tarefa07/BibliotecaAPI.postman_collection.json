  "item": [
    {
      "name": "PostLivros",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const numero = Math.floor(Math.random() * 1000);\r",
              "\r",
              "pm.environment.set(\r",
              "    \"tituloLivro\",\r",
              "    \"Livro_\" + numero\r",
              ");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status deve ser 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Response possui id\", function () {\r",
              "\r",
              "    const json = pm.response.json();\r",
              "\r",
              "    pm.expect(json.id).to.not.be.null;\r",
              "});\r",
              "\r",
              "const json = pm.response.json();\r",
              "\r",
              "pm.environment.set(\r",
              "    \"livroId\",\r",
              "    json.id\r",
              ");\r",
              "\r",
              "pm.test(\"Tempo menor que 500ms\", function () {\r",
              "\r",
              "    pm.expect(\r",
              "        pm.response.responseTime\r",
              "    ).to.be.below(500);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"titulo\": \"{{tituloLivro}}\",\r\n  \"autor\": \"{{$randomFullName}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/livros",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "livros"
          ]
        }
      },
      "response": []
    },
