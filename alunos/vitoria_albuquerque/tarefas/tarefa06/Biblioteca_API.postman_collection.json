{
  "info": {
    "_postman_id": "3d7395d4-1d44-44b9-b8a6-a37122be0bab",
    "name": "Biblioteca_API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "27311872"
  },
  "item": [
    {
      "name": "cadastrar",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const numero = Math.floor(Math.random() * 1000);\r",
              "\r",
              "pm.environment.set(\r",
              "    \"tituloLivro\",\r",
              "    \"Livro_\" + numero\r",
              ")"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status deve ser 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Response possui id\", function () {\r",
              "\r",
              "    const json = pm.response.json();\r",
              "\r",
              "    pm.expect(json.id).to.not.be.null;\r",
              "});\r",
              "\r",
              "const json = pm.response.json();\r",
              "\r",
              "pm.environment.set(\r",
              "    \"livroId\",\r",
              "    json.id\r",
              ");\r",
              "\r",
              "pm.test(\"Tempo menor que 500ms\", function () {\r",
              "\r",
              "    pm.expect(\r",
              "        pm.response.responseTime\r",
              "    ).to.be.below(500);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"titulo\": \"{{tituloLivro}}\",\r\n  \"autor\": \"Robert Martin\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/livros",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "livros"
          ]
        }
      },
      "response": []
    },
    {
      "name": "buscarTodos",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status deve ser 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Todos os livros possuem id\", function () {\r",
              "\r",
              "    const json = pm.response.json();\r",
              "\r",
              "    json.content.forEach((livro) => {\r",
              "        pm.expect(livro.id).to.not.be.null;\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Lista não vazia\", function () {\r",
              "\r",
              "    const json = pm.response.json();\r",
              "\r",
              "    pm.expect(json.content.length)\r",
              "        .to.be.above(0);\r",
              "});\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/livros?page=0&size=10",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "livros"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "10"
            }
          ]
        }
      },
      "response": []
    },
